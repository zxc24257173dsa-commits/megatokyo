# Copy to .env for local development. NEVER commit .env or put real tokens here in production;
# production values come from GCP Secret Manager.
ERP_ENV=dev
ERP_DATABASE_URL=postgresql+psycopg://erp:erp_dev_pw@localhost:5432/erp_dev
ERP_LOG_LEVEL=INFO
ERP_LOG_JSON=true
# Tests use a separate database (it is wiped and re-migrated on every test run):
ERP_TEST_DATABASE_URL=postgresql+psycopg://erp:erp_dev_pw@localhost:5432/erp_test
