# Copy to .env for local development. NEVER commit .env. In staging/production these values
# come from GCP Secret Manager, and the app refuses to start with the dev defaults.
ERP_ENV=dev
ERP_DATABASE_URL=postgresql+psycopg://erp:erp_dev_pw@localhost:5432/erp_dev
ERP_LOG_LEVEL=INFO
ERP_LOG_JSON=true

# Local http only. Must be true (the default) anywhere served over https.
ERP_COOKIE_SECURE=false

# Generate real values with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"                    -> ERP_JWT_SECRET
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())" -> ERP_DATA_ENCRYPTION_KEY
# Losing ERP_DATA_ENCRYPTION_KEY makes stored MFA secrets / API tokens unreadable: back it up in Secret Manager.
# ERP_JWT_SECRET=
# ERP_DATA_ENCRYPTION_KEY=

# Tests use a separate database (wiped and re-migrated on every test run):
ERP_TEST_DATABASE_URL=postgresql+psycopg://erp:erp_dev_pw@localhost:5432/erp_test
